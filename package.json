{
    "name": "vrcx-extras",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:server": "node --disable-warning=ExperimentalWarning --watch server.ts",
        "server": "node --disable-warning=ExperimentalWarning server.ts",
        "build": "npm run typecheck && vite build",
        "package:bundle": "npx esbuild server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/server.cjs",
        "package:linux": "npm run build && npm run package:bundle && npx @yao-pkg/pkg --sea dist-server/server.cjs -o build/vrcx-extras",
        "package:win": "npm run build && npm run package:bundle && npx @yao-pkg/pkg --sea dist-server/server.cjs -t node22-win-x64 -o build/vrcx-extras.exe",
        "package:all": "npm run package:linux && npm run package:win",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@iarna/toml": "^2.2.5",
        "@node-steam/vdf": "^2.2.0",
        "@types/cors": "^2.8.19",
        "@types/react-window": "^1.8.8",
        "@types/swagger-ui-express": "^4.1.8",
        "any-ascii": "^0.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "confusables": "^1.1.1",
        "cors": "^2.8.6",
        "diff": "^9.0.0",
        "express": "^4.21.2",
        "lucide-react": "^0.475.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "^8.3.0",
        "react-window": "^2.3.0",
        "swagger-ui-express": "^5.0.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/diff": "^7.0.2",
        "@types/express": "^5.0.0",
        "@types/node": "^22.13.4",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.3",
        "vite": "^6.1.0"
    }
}
